# Local docker-compose configuration
# Copy this file to .env before running `docker compose up`

# PostgreSQL credentials for local postgres container
POSTGRES_USER=radius_user
POSTGRES_PASSWORD=change-me-local-postgres-password
POSTGRES_DB=radius_db

# Redis authentication for local redis container
REDIS_PASSWORD=change-me-local-redis-password

# HMAC secret key for JWT tokens (required, minimum 32 bytes)
# Production: generate with `openssl rand -hex 32`
JWT_SECRET_KEY=change-me-local-jwt-secret-at-least-32-bytes

# Server listen port inside container and exposed on host
PORT=8080

# Gin operational mode: "debug" for development, "release" for production
GIN_MODE=debug

# Structured log verbosity: "debug", "info", "warn", or "error" (default: "info")
# Production: "info" or "warn"
LOG_LEVEL=info

# Automatically run database migrations on API container start: "true" or "false"
# Production: recommend running migrations in a separate deploy job
RUN_MIGRATIONS=true

# Comma-separated allowed CORS origins for web clients (e.g. Expo web on port 8081)
# Leave empty to disable CORS and reject cross-origin WebSockets (safe default for native-only clients)
ALLOWED_ORIGINS=http://localhost:8081
