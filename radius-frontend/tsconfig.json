{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "module": "esnext",
        "strict": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@/assets/*": [
                "./assets/*"
            ]
        }
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        ".expo/types/**/*.ts",
        "expo-env.d.ts"
    ]
}
