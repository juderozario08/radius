# PostgreSQL connection URL (required)
# Production: use a strong password and sslmode=require (e.g. postgres://user:pass@host:5432/dbname?sslmode=require)
DATABASE_URL=postgres://radius_user:replace-with-a-local-password@localhost:5432/radius_db?sslmode=disable

# Redis connection URL (required)
# Production: use strong auth and TLS if supported (e.g. rediss://:pass@host:6379/0)
REDIS_URL=redis://:replace-with-a-local-password@localhost:6379/0

# HMAC secret key for signing JWTs (required, minimum 32 bytes)
# Production: generate with `openssl rand -hex 32` or similar high-entropy source
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes

# Server listen port (default: 8080)
PORT=8080

# Gin operational mode: "debug", "release", or "test"
# Production: "release"
GIN_MODE=debug

# Structured log verbosity level: "debug", "info", "warn", or "error" (default: "info")
# Production: "info" or "warn"
LOG_LEVEL=info

# Comma-separated list of allowed CORS origins for browser/web clients
# Leave empty to disable CORS headers and reject cross-origin WebSocket handshakes (safe default for native-only clients)
# Production example: https://app.radius.example.com
ALLOWED_ORIGINS=http://localhost:8081

# Automatically apply database schema migrations on startup: "true" or "false"
# Debug mode defaults to true. In release mode, defaults to false unless set to "true".
# Production: recommend running migrations via a separate deploy step/job rather than concurrent app containers
RUN_MIGRATIONS=true

# Database and Redis container credentials (used when running local DB/Redis scripts or containers)
POSTGRES_USER=radius_user
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=radius_db
REDIS_PASSWORD=replace-with-a-local-password
